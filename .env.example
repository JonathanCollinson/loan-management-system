# Copy to repo root as `.env`. The API loads this file even when started from `apps/api` (see apps/api envFilePaths).
# Install deps from repo root: `pnpm install` (see package.json / pnpm-workspace.yaml).
# MongoDB
#
# `pnpm run dev:api` starts Compose Mongo on host port 27018 (see docker-compose.yml). Use directConnection so the
# driver talks only to that host; otherwise replica-set discovery can time out (it may try the internal hostname "mongo").
MONGODB_URI=mongodb://127.0.0.1:27018/lms?directConnection=true
#
# If you run mongod yourself on the default port instead of Docker:
# MONGODB_URI=mongodb://127.0.0.1:27017/lms
#
# Atlas / other hosts: use the connection string from your provider (replica set; no directConnection needed).

# API (apps/api)
PORT=4000
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_SEC=604800

# Seed first SuperAdmin on startup if no users exist
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# Web (apps/web)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Playwright E2E (optional; defaults use SEED_SUPER_ADMIN_* and fixed e2e-admin@local.test / e2e-user@local.test)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# E2E_SUPER_ADMIN_EMAIL=
# E2E_SUPER_ADMIN_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

# API integration tests (optional — use real Mongo instead of Mongo Memory Server download)
# INTEGRATION_MONGODB_URI=mongodb://127.0.0.1:27017/lms_test
